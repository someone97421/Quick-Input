<Window x:Class="QuickInput.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置"
        Width="440"
        Height="250"
        MinWidth="420"
        MinHeight="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="快捷键设置"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="#111827" />

    <Border Grid.Row="1"
            Margin="0,18,0,0"
            Padding="14"
            Background="#FFFFFF"
            BorderBrush="#D6DAE3"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="唤起/退出悬浮输入框"
                   FontSize="13"
                   Foreground="#4B5563"
                   Margin="0,0,0,8" />
        <TextBox x:Name="HotkeyBox"
                 Grid.Row="1"
                 Height="42"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Padding="12,0"
                 BorderBrush="#AEB8C8"
                 Background="#F9FAFB"
                 PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                 GotKeyboardFocus="HotkeyBox_OnGotKeyboardFocus" />
      </Grid>
    </Border>

    <TextBlock x:Name="MessageText"
               Grid.Row="2"
               Margin="2,12,2,0"
               TextWrapping="Wrap"
               FontSize="12"
               Foreground="#64748B" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="恢复默认"
              Width="84"
              Height="34"
              Margin="0,0,8,0"
              Click="Default_OnClick" />
      <Button Content="取消"
              Width="76"
              Height="34"
              Margin="0,0,8,0"
              Click="Cancel_OnClick" />
      <Button Content="保存"
              Width="76"
              Height="34"
              Background="#2563EB"
              Foreground="#FFFFFF"
              BorderBrush="#2563EB"
              Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</Window>
