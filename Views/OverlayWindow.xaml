<Window x:Class="QuickInput.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickInput"
        Icon="/Assets/quick-input.ico"
        MinWidth="280"
        MinHeight="140"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Focusable="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="8"
                        CornerRadius="8"
                        GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootBorder"
          Margin="8"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource BorderBrushSoft}"
          BorderThickness="1"
          CornerRadius="8"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        ShadowDepth="6"
                        Opacity="0.22"
                        Color="{DynamicResource ShadowColor}" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
        <RowDefinition Height="24" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            Background="{DynamicResource HeaderBackground}"
            MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0">
          <Ellipse Width="9"
                   Height="9"
                   Fill="{DynamicResource AccentBrush}"
                   Margin="0,0,8,0" />
          <TextBlock Text="QuickInput"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Width="32"
                Height="28"
                Margin="0,4,6,4"
                Content="×"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Background="Transparent"
                BorderThickness="0"
                Click="Cancel_OnClick" />
      </Grid>

      <TextBox x:Name="InputBox"
               Grid.Row="1"
               Margin="12,10,12,6"
               AcceptsReturn="True"
               AcceptsTab="True"
               IsReadOnly="False"
               IsTabStop="True"
               Focusable="True"
               BorderThickness="0"
               Background="{DynamicResource InputBackground}"
               Foreground="{DynamicResource InputForeground}"
               CaretBrush="{DynamicResource InputForeground}"
               FontSize="18"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Padding="10"
               TextChanged="InputBox_OnTextChanged"
               PreviewKeyDown="InputBox_OnPreviewKeyDown" />

      <Grid Grid.Row="2"
            Margin="12,0,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button x:Name="PhraseButton"
                Grid.Column="1"
                Width="28"
                Height="22"
                Padding="0"
                ToolTip="快捷短语"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                Click="PhraseButton_OnClick">
          <Viewbox Width="14"
                   Height="14">
            <Canvas Width="24"
                    Height="24">
              <Path Stroke="{DynamicResource SecondaryTextBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Fill="Transparent"
                    Data="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              <Path Stroke="{DynamicResource SecondaryTextBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="M8 9h8 M8 13h5" />
            </Canvas>
          </Viewbox>
        </Button>
        <Border x:Name="ResizeHandle"
                Grid.Column="2"
                Width="18"
                Height="18"
                Margin="4,0,0,0"
                Background="Transparent"
                Cursor="SizeNWSE"
                ToolTip="拖拽调整大小"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                MouseLeftButtonDown="ResizeHandle_OnMouseLeftButtonDown">
          <Path Stroke="{DynamicResource MutedTextBrush}"
                StrokeThickness="1.4"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Data="M12 16H16V12 M7 16H8 M12 11H16V7" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
